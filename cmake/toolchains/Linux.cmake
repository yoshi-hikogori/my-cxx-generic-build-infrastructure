# Linux上のネイティブビルド専用。コンパイラは事前定義設定で変更できる
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
	message(FATAL_ERROR "Linux.cmakeはLinux上のネイティブビルド専用です。クロスビルドには専用のSDKツールチェーンが必要です")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CpuBaseline.cmake")
if(DEFINED CMAKE_SYSTEM_NAME AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
	message(FATAL_ERROR "Linux.cmakeでは${CMAKE_SYSTEM_NAME}をターゲットにできません")
endif()
if(NOT CMAKE_CXX_COMPILER)
	find_program(CMAKE_CXX_COMPILER NAMES clang++ g++ REQUIRED)
endif()

set(CGBI_TARGET_ENVIRONMENT "" CACHE STRING "Target triple environment; empty uses compiler defaults")
set_property(CACHE CGBI_TARGET_ENVIRONMENT PROPERTY STRINGS "" gnu)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CGBI_TARGET_ENVIRONMENT CMAKE_SYSTEM_PROCESSOR)
list(REMOVE_DUPLICATES CMAKE_TRY_COMPILE_PLATFORM_VARIABLES)

if(NOT CGBI_TARGET_ENVIRONMENT STREQUAL "")
	if(NOT CGBI_TARGET_ENVIRONMENT STREQUAL "gnu")
		message(FATAL_ERROR "CGBI_TARGET_ENVIRONMENT：Linux.cmakeでサポートされていない値です：${CGBI_TARGET_ENVIRONMENT}")
	endif()
	block(SCOPE_FOR VARIABLES PROPAGATE CMAKE_CXX_COMPILER CMAKE_CXX_COMPILER_TARGET)
		foreach(kind IN ITEMS target host)
			if(kind STREQUAL "target")
				set(processor "${CMAKE_SYSTEM_PROCESSOR}")
			else()
				set(processor "${CMAKE_HOST_SYSTEM_PROCESSOR}")
			endif()
			string(TOLOWER "${processor}" processor)
			if(processor MATCHES "^(amd64|x86_64|x64)$")
				set(${kind}_arch x86_64)
			elseif(processor MATCHES "^(arm64|aarch64)$")
				set(${kind}_arch aarch64)
			else()
				message(FATAL_ERROR "Linux.cmake：${kind}のarchitectureを指定できません：${processor}")
			endif()
		endforeach()
		if(NOT target_arch STREQUAL host_arch)
			message(FATAL_ERROR "Linux.cmakeはネイティブビルド専用です。クロスビルドには専用のSDKツールチェーンが必要です")
		endif()
		cmake_path(GET CMAKE_CXX_COMPILER FILENAME compiler_name)
		if(compiler_name MATCHES "^clang\\+\\+(-[0-9.]+)?(\\.exe)?$")
			if(DEFINED CMAKE_CXX_COMPILER_TARGET AND NOT CMAKE_CXX_COMPILER_TARGET STREQUAL "")
				if(NOT CMAKE_CXX_COMPILER_TARGET MATCHES "^${target_arch}-([^-]+-)?linux-gnu$")
					message(FATAL_ERROR "CMAKE_CXX_COMPILER_TARGETとLinuxの標的指定が競合しています：${CMAKE_CXX_COMPILER_TARGET}")
				endif()
			else()
				set(CMAKE_CXX_COMPILER_TARGET "${target_arch}-unknown-linux-gnu")
			endif()
		elseif(compiler_name MATCHES "(^|-)g\\+\\+(-[0-9.]+)?(\\.exe)?$")
			if(DEFINED CMAKE_CXX_COMPILER_TARGET AND NOT CMAKE_CXX_COMPILER_TARGET STREQUAL "")
				message(FATAL_ERROR "GCCの標的はコンパイラで選択してください。CMAKE_CXX_COMPILER_TARGETは使用できません")
			endif()
			set(compiler_path "compiler_path-NOTFOUND")
			find_program(compiler_path NAMES "${CMAKE_CXX_COMPILER}" NO_CACHE NO_CMAKE_FIND_ROOT_PATH REQUIRED)
			set(CMAKE_CXX_COMPILER "${compiler_path}")
			execute_process(
				COMMAND "${CMAKE_CXX_COMPILER}" -dumpmachine
				RESULT_VARIABLE result OUTPUT_VARIABLE triple ERROR_VARIABLE error
				OUTPUT_STRIP_TRAILING_WHITESPACE
			)
			if(NOT result STREQUAL "0")
				message(FATAL_ERROR "GCCの標的tripleを取得できません：${CMAKE_CXX_COMPILER}：${result}\n${error}")
			endif()
			if(NOT triple MATCHES "^${target_arch}-([^-]+-)?linux-gnu$")
				message(FATAL_ERROR "GCCの標的tripleとLinuxの標的指定が一致しません：要求=${target_arch}-linux-gnu、実際=${triple}")
			endif()
		else()
			message(FATAL_ERROR "CGBI_TARGET_ENVIRONMENTの指定にはClangまたはGCCのC++ドライバを指定してください：${CMAKE_CXX_COMPILER}")
		endif()
	endblock()
endif()
