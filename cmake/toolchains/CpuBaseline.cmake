set(CGBI_CPU_BASELINE "" CACHE STRING "Build-wide CPU baseline; empty uses compiler defaults")
set_property(CACHE CGBI_CPU_BASELINE PROPERTY STRINGS "" x86-64-v3 armv8.2-a)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CGBI_CPU_BASELINE)
list(REMOVE_DUPLICATES CMAKE_TRY_COMPILE_PLATFORM_VARIABLES)

if(NOT CGBI_CPU_BASELINE STREQUAL "")
	# compilerの識別後、標準フラグのcache初期化前に変換する
	if(CMAKE_USER_MAKE_RULES_OVERRIDE_CXX AND
		NOT CMAKE_USER_MAKE_RULES_OVERRIDE_CXX STREQUAL "${CMAKE_CURRENT_LIST_DIR}/InitializeCpuBaseline.cmake")
		message(FATAL_ERROR "CGBI_CPU_BASELINEと独自のCMAKE_USER_MAKE_RULES_OVERRIDE_CXXは併用できません")
	endif()
	set(CMAKE_USER_MAKE_RULES_OVERRIDE_CXX "${CMAKE_CURRENT_LIST_DIR}/InitializeCpuBaseline.cmake")
endif()
