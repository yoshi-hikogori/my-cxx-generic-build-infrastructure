# Windowsをホストとする場合に限る。Ninjaは標的のMSVC開発環境から実行すること
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
	message(FATAL_ERROR "Windows.cmakeを使用するには、ホストOSがWindowsである必要があります")
endif()
if(DEFINED CMAKE_SYSTEM_NAME AND NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
	message(FATAL_ERROR "Windows.cmakeでは${CMAKE_SYSTEM_NAME}をターゲットにできません")
endif()
if(NOT CMAKE_CXX_COMPILER)
	find_program(CMAKE_CXX_COMPILER NAMES clang-cl cl REQUIRED)
endif()
if(DEFINED MY_IMPORT_STD_TARGET_ARCH AND NOT MY_IMPORT_STD_TARGET_ARCH STREQUAL "")
	block(SCOPE_FOR VARIABLES PROPAGATE
		CMAKE_CXX_COMPILER_TARGET CMAKE_SYSTEM_NAME CMAKE_SYSTEM_PROCESSOR
		CMAKE_TRY_COMPILE_PLATFORM_VARIABLES)
		if(NOT MY_IMPORT_STD_TARGET_ARCH MATCHES "^(x86_64|aarch64)$")
			message(FATAL_ERROR "MY_IMPORT_STD_TARGET_ARCH：サポートされていない値です：${MY_IMPORT_STD_TARGET_ARCH}")
		endif()
		# Clangの既定の標的は、MSVC開発環境の対象アーキテクチャを引き継がない
		cmake_path(GET CMAKE_CXX_COMPILER FILENAME compiler_name)
		if(compiler_name MATCHES "^clang")
			set(target_triple "${MY_IMPORT_STD_TARGET_ARCH}-pc-windows-msvc")
			if(DEFINED CMAKE_CXX_COMPILER_TARGET AND NOT CMAKE_CXX_COMPILER_TARGET STREQUAL target_triple)
				message(FATAL_ERROR "CMAKE_CXX_COMPILER_TARGETとWindowsのターゲットアーキテクチャが競合しています")
			endif()
			set(CMAKE_CXX_COMPILER_TARGET "${target_triple}")
		endif()
		string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" host_processor)
		if(MY_IMPORT_STD_TARGET_ARCH STREQUAL "aarch64")
			if(NOT host_processor MATCHES "^(arm64|aarch64)$")
				set(CMAKE_SYSTEM_NAME Windows)
				set(CMAKE_SYSTEM_PROCESSOR ARM64)
			endif()
		elseif(NOT host_processor MATCHES "^(amd64|x86_64|x64)$")
			set(CMAKE_SYSTEM_NAME Windows)
			set(CMAKE_SYSTEM_PROCESSOR AMD64)
		endif()
		list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MY_IMPORT_STD_TARGET_ARCH)
	endblock()
endif()
