if(NOT DEFINED DIST_DIRECTORY OR DIST_DIRECTORY STREQUAL "")
	message(FATAL_ERROR "DIST_DIRECTORYを指定してください")
endif()
if(NOT IS_DIRECTORY "${DIST_DIRECTORY}")
	message(FATAL_ERROR "DIST_DIRECTORYがディレクトリではありません：${DIST_DIRECTORY}")
endif()

file(GLOB checksum_files "${DIST_DIRECTORY}/*.sha256")
if(NOT checksum_files)
	message(FATAL_ERROR "${DIST_DIRECTORY}にSHA-256ファイルが見つかりません")
endif()

foreach(checksum_file IN LISTS checksum_files)
	file(READ "${checksum_file}" checksum_line)
	string(STRIP "${checksum_line}" checksum_line)
	string(REGEX MATCH "^([0-9A-Fa-f]+)[ \t]+[*]?(.+)$" matched "${checksum_line}")
	if(NOT matched)
		message(FATAL_ERROR "チェックサムファイルの形式が正しくありません：${checksum_file}")
	endif()

	set(expected_hash "${CMAKE_MATCH_1}")
	set(package_name "${CMAKE_MATCH_2}")
	string(LENGTH "${expected_hash}" hash_length)
	if(NOT hash_length EQUAL 64)
		message(FATAL_ERROR "SHA-256の長さが正しくありません：${checksum_file}")
	endif()
	string(TOLOWER "${expected_hash}" expected_hash)
	cmake_path(GET checksum_file PARENT_PATH checksum_directory)
	set(package_file "${checksum_directory}/${package_name}")
	if(NOT EXISTS "${package_file}" OR IS_DIRECTORY "${package_file}")
		message(FATAL_ERROR "パッケージが見つかりません：${package_file}")
	endif()

	file(SHA256 "${package_file}" actual_hash)
	if(NOT actual_hash STREQUAL expected_hash)
		message(FATAL_ERROR "チェックサムが一致しません：${package_file}")
	endif()

	message(STATUS "検証しました：${package_file}")
endforeach()