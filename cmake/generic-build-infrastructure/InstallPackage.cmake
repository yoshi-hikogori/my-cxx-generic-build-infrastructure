if(NOT IS_ABSOLUTE "${CMAKE_INSTALL_PREFIX}" OR NOT DEFINED CPACK_TEMPORARY_DIRECTORY)
	message(FATAL_ERROR "InstallPackage.cmakeはCPackのinstall工程から実行してください")
endif()
if(CGBI_CONFIGURATIONS)
	set(configurations "${CPACK_BUILD_CONFIG}")
else()
	set(configurations "${CGBI_BUILD_TYPE}")
endif()
set(CMAKE_ERROR_ON_ABSOLUTE_INSTALL_DESTINATION ON)
if(configurations STREQUAL "")
	set(CMAKE_INSTALL_CONFIG_NAME "")
	include("${CGBI_BINARY_DIR}/cmake_install.cmake")
else()
	foreach(configuration IN LISTS configurations)
		set(CMAKE_INSTALL_CONFIG_NAME "${configuration}")
		include("${CGBI_BINARY_DIR}/cmake_install.cmake")
	endforeach()
endif()
