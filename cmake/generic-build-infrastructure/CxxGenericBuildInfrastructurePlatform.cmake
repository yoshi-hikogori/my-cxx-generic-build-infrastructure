include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/CxxGenericBuildInfrastructureTargets.cmake")

function(_cmake_generic_build_infrastructure_cpu_options output baseline)
	if(ARGNC GREATER 0)
		message(FATAL_ERROR "_cmake_generic_build_infrastructure_cpu_options：余分な引数が指定されています")
	endif()
	set(options)
	if(NOT baseline STREQUAL "")
		if(NOT baseline MATCHES "^(x86-64-v3|armv8.2-a)$")
			message(FATAL_ERROR "CPU_BASELINE：対応していない値です：${baseline}")
		endif()
		if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
			if(baseline STREQUAL "x86-64-v3")
				set(options /arch:AVX2)
			else()
				set(options /arch:armv8.2)
			endif()
		elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
			set(options "/clang:-march=${baseline}")
		elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|GNU)$" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
			set(options "-march=${baseline}")
		else()
			message(FATAL_ERROR "CPU_BASELINE：このコンパイラは対応していません")
		endif()
	endif()
	set("${output}" "${options}" PARENT_SCOPE)
endfunction()

# project()の後に呼び出す。空の要件はツールチェーンに委譲する
function(cmake_generic_build_infrastructure_validate_target_platform)
	cmake_parse_arguments(PARSE_ARGN arg "" "TARGET_ARCH;CPU_BASELINE;TARGET_ENVIRONMENT;ENABLE_AVX2" "")
	if(DEFINED arg_UNPARSED_ARGUMENTS OR DEFINED arg_KEYWORDS_MISSING_VALUES)
		message(FATAL_ERROR "cmake_generic_build_infrastructure_validate_target_platform：未知の引数または値の欠落があります")
	endif()
	set(arch "${arg_TARGET_ARCH}")
	if(NOT arch STREQUAL "" AND NOT arch MATCHES "^(x86_64|aarch64)$")
		message(FATAL_ERROR "TARGET_ARCH：対応していない値です：${arch}")
	endif()
	_cmake_generic_build_infrastructure_cpu_options(cpu_options "${arg_CPU_BASELINE}")
	if(arg_CPU_BASELINE STREQUAL "x86-64-v3")
		set(cpu_arch x86_64)
	elseif(arg_CPU_BASELINE STREQUAL "armv8.2-a")
		set(cpu_arch aarch64)
	else()
		set(cpu_arch "")
	endif()
	if(NOT cpu_arch STREQUAL "")
		if(NOT arch STREQUAL "" AND NOT arch STREQUAL cpu_arch)
			message(FATAL_ERROR "CPU_BASELINEとTARGET_ARCHが競合しています")
		endif()
		set(arch "${cpu_arch}")
	endif()
	if(arg_ENABLE_AVX2 AND arch STREQUAL "aarch64")
		message(FATAL_ERROR "ENABLE_AVX2を有効にするには、標的にx86を指定してください")
	endif()
	set(source "")
	if(arch STREQUAL "x86_64")
		string(APPEND source "#if !defined(__x86_64__) && !defined(_M_X64)\n#error Expected x86_64 target\n#endif\n")
	elseif(arch STREQUAL "aarch64")
		string(APPEND source "#if !defined(__aarch64__) && !defined(_M_ARM64)\n#error Expected aarch64 target\n#endif\n")
		string(APPEND source "#ifdef __AARCH64EB__\n#error Expected little-endian aarch64 target\n#endif\n")
	endif()
	if(NOT arch STREQUAL "")
		string(APPEND source "static_assert(sizeof(void*) == 8);\n")
	endif()
	if(DEFINED arg_TARGET_ENVIRONMENT AND NOT arg_TARGET_ENVIRONMENT STREQUAL "")
		if(NOT arg_TARGET_ENVIRONMENT STREQUAL "gnu")
			message(FATAL_ERROR "TARGET_ENVIRONMENT：対応していない値です：${arg_TARGET_ENVIRONMENT}")
		endif()
		if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
			message(FATAL_ERROR "TARGET_ENVIRONMENT=gnuを指定するには、Linux/glibcが必要です")
		endif()
		string(APPEND source "#include <features.h>\n#ifndef __GLIBC__\n#error Expected GNU glibc\n#endif\n")
	endif()
	if(arg_CPU_BASELINE STREQUAL "x86-64-v3")
		string(APPEND source "#ifndef __AVX2__\n#error CPU baseline flag did not enable AVX2\n#endif\n")
		if(CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|GNU)$")
			foreach(macro IN ITEMS __SSE3__ __SSSE3__ __SSE4_1__ __SSE4_2__ __POPCNT__ __AVX__
				__F16C__ __FMA__ __BMI__ __BMI2__ __LZCNT__ __MOVBE__ __XSAVE__ __LAHF_SAHF__
				__GCC_HAVE_SYNC_COMPARE_AND_SWAP_16)
				string(APPEND source "#ifndef ${macro}\n#error CPU baseline flag did not define ${macro}\n#endif\n")
			endforeach()
		endif()
	endif()
	if(cpu_options)
		include(CheckCXXCompilerFlag)
		string(SHA256 key "${CMAKE_CXX_COMPILER};${CMAKE_CXX_COMPILER_TARGET};${cpu_options}")
		set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
		check_cxx_compiler_flag("${cpu_options}" "GENERIC_BUILD_INFRASTRUCTURE_CPU_FLAG_${key}")
		if(NOT GENERIC_BUILD_INFRASTRUCTURE_CPU_FLAG_${key})
			message(FATAL_ERROR "CPU_BASELINE：コンパイラが${cpu_options}に対応していません")
		endif()
	endif()
	if(NOT source STREQUAL "")
		include(CheckCXXSourceCompiles)
		string(APPEND source "int main() { return 0; }\n")
		string(JOIN " " CMAKE_REQUIRED_FLAGS ${cpu_options})
		set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
		string(SHA256 key "${CMAKE_CXX_COMPILER};${CMAKE_CXX_COMPILER_TARGET};${source};${CMAKE_REQUIRED_FLAGS}")
		check_cxx_source_compiles("${source}" "GENERIC_BUILD_INFRASTRUCTURE_PLATFORM_${key}")
		if(NOT GENERIC_BUILD_INFRASTRUCTURE_PLATFORM_${key})
			message(FATAL_ERROR "標的環境の検証に失敗しました：architecture=${arch}、CPU=${arg_CPU_BASELINE}、environment=${arg_TARGET_ENVIRONMENT}。CMakeConfigureLog.yamlを確認してください")
		endif()
	endif()
endfunction()

# CPU要件は非公開のコンパイル設定として適用する。実行時のfallbackは無し
function(cmake_generic_build_infrastructure_apply_cpu_settings)
	cmake_parse_arguments(PARSE_ARGN arg "" "TARGET;TARGET_ARCH;CPU_BASELINE;ENABLE_AVX2" "")
	if(DEFINED arg_UNPARSED_ARGUMENTS OR DEFINED arg_KEYWORDS_MISSING_VALUES OR
		NOT DEFINED arg_TARGET OR arg_TARGET STREQUAL "")
		message(FATAL_ERROR "cmake_generic_build_infrastructure_apply_cpu_settings：TARGET <target>と有効なCPU設定を指定してください")
	endif()
	_cmake_generic_build_infrastructure_validate_target(cmake_generic_build_infrastructure_apply_cpu_settings "${arg_TARGET}")
	cmake_generic_build_infrastructure_validate_target_platform(
		TARGET_ARCH "${arg_TARGET_ARCH}"
		CPU_BASELINE "${arg_CPU_BASELINE}"
		ENABLE_AVX2 "${arg_ENABLE_AVX2}"
	)
	_cmake_generic_build_infrastructure_cpu_options(cpu_options "${arg_CPU_BASELINE}")
	target_compile_options("${arg_TARGET}" PRIVATE ${cpu_options})
	if(arg_ENABLE_AVX2 AND NOT arg_CPU_BASELINE STREQUAL "x86-64-v3")
		if(arg_CPU_BASELINE STREQUAL "armv8.2-a" OR arg_TARGET_ARCH STREQUAL "aarch64")
			message(FATAL_ERROR "ENABLE_AVX2を有効にするには、標的にx86を指定してください")
		endif()
		string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" processor)
		if(NOT processor MATCHES "^(amd64|x86_64|x64|i[3-6]86|x86)$")
			message(FATAL_ERROR "ENABLE_AVX2を有効にするには、標的にx86を指定してください。現在の値：${CMAKE_SYSTEM_PROCESSOR}")
		endif()
		if(NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT MATCHES "^(GNU|MSVC)$")
			message(FATAL_ERROR "ENABLE_AVX2：このコンパイラフロントエンドは対応していません")
		endif()
		target_compile_options("${arg_TARGET}" PRIVATE
			$<$<CXX_COMPILER_FRONTEND_VARIANT:MSVC>:/arch:AVX2>
			$<$<CXX_COMPILER_FRONTEND_VARIANT:GNU>:-mavx2>
		)
	endif()
endfunction()

function(cmake_generic_build_infrastructure_require_module_generator)
	if(ARGNC GREATER 0)
		message(FATAL_ERROR "cmake_generic_build_infrastructure_require_module_generator：余分な引数が指定されています")
	endif()
	if(NOT CMAKE_GENERATOR MATCHES "^Ninja")
		message(FATAL_ERROR "import std;とモジュールのexportにはNinjaまたはNinja Multi-Configが必要です")
	endif()
endfunction()
