cmake_minimum_required(VERSION 4.5)

# CMakeはcallbackのコマンドにindexファイル名を追加する
# index処理後のcleanupで元データが削除される前に、参照先のデータを移動せずにコピーする
if(NOT DEFINED OUTPUT_DIRECTORY OR NOT IS_ABSOLUTE "${OUTPUT_DIRECTORY}" OR CMAKE_ARGC LESS 5)
	message(FATAL_ERROR "OUTPUT_DIRECTORYには絶対パスを、instrumentation indexにはファイルを指定してください")
endif()
set(index_argument "${CMAKE_ARGC}")
math(DECREMENT index_argument)
set(index_file "${CMAKE_ARGV${index_argument}}")
cmake_path(CONVERT "${index_file}" TO_CMAKE_PATH_LIST index_file NORMALIZE)
file(READ "${index_file}" index)
string(JSON data_dir GET "${index}" dataDir)
string(JSON build_dir GET "${index}" buildDir)
cmake_path(CONVERT "${data_dir}" TO_CMAKE_PATH_LIST data_dir NORMALIZE)
cmake_path(CONVERT "${build_dir}" TO_CMAKE_PATH_LIST build_dir NORMALIZE)
cmake_path(CONVERT "${OUTPUT_DIRECTORY}" TO_CMAKE_PATH_LIST OUTPUT_DIRECTORY NORMALIZE)
if(NOT IS_ABSOLUTE "${data_dir}" OR NOT IS_ABSOLUTE "${build_dir}" OR
	NOT "${build_dir}" PATH_IS_PREFIX "${OUTPUT_DIRECTORY}" OR
	"${data_dir}" PATH_IS_PREFIX "${OUTPUT_DIRECTORY}")
	message(FATAL_ERROR "Instrumentationの出力先はビルドディレクトリ内、かつCMakeのデータディレクトリ外にしてください")
endif()

function(copy_data_file relative)
	if(ARGNC GREATER 0 OR IS_ABSOLUTE "${relative}" OR relative STREQUAL "")
		message(FATAL_ERROR "Instrumentationデータの相対パスを1つ指定してください")
	endif()
	set(source "${data_dir}/${relative}")
	cmake_path(NORMAL_PATH source)
	if(NOT "${data_dir}" PATH_IS_PREFIX "${source}")
		message(FATAL_ERROR "Instrumentationデータのパスがデータディレクトリの外を指しています：${relative}")
	endif()
	set(destination "${OUTPUT_DIRECTORY}/${relative}")
	cmake_path(GET destination PARENT_PATH parent)
	file(MAKE_DIRECTORY "${parent}")
	file(COPY_FILE "${source}" "${destination}" ONLY_IF_DIFFERENT)
endfunction()

string(JSON snippets ARRAY_SPLIT "${index}" snippets)
foreach(element IN LISTS snippets)
	string(JSON relative GET "${element}")
	copy_data_file("${relative}")
	file(READ "${data_dir}/${relative}" snippet)
	string(JSON member_count LENGTH "${snippet}")
	set(members "")
	if(member_count GREATER 0)
		math(DECREMENT member_count)
		foreach(member_index RANGE 0 ${member_count})
			string(JSON member MEMBER "${snippet}" ${member_index})
			list(APPEND members "${member}")
		endforeach()
	endif()
	foreach(reference IN ITEMS cmakeContent traceFile)
		if(reference IN_LIST members)
			string(JSON reference_type TYPE "${snippet}" "${reference}")
			if(NOT reference_type STREQUAL "NULL")
				string(JSON relative GET "${snippet}" "${reference}")
				copy_data_file("${relative}")
			endif()
		endif()
	endforeach()
endforeach()

string(JSON member_count LENGTH "${index}")
math(DECREMENT member_count)
foreach(member_index RANGE 0 ${member_count})
	string(JSON member MEMBER "${index}" ${member_index})
	if(member STREQUAL "trace")
		string(JSON relative GET "${index}" trace)
		copy_data_file("${relative}")
	endif()
endforeach()
string(JSON encoded_directory STRING_ENCODE "${OUTPUT_DIRECTORY}")
string(JSON index SET "${index}" dataDir "${encoded_directory}")
cmake_path(GET index_file FILENAME index_name)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}/index")
file(WRITE "${OUTPUT_DIRECTORY}/index/${index_name}" "${index}\n")
