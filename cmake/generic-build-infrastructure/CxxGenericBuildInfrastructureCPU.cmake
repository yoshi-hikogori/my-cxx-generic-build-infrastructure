include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/CxxGenericBuildInfrastructureTargets.cmake")

function(_cmake_generic_build_infrastructure_cpu_options output baseline enable_avx2)
	if(ARGNC GREATER 0)
		message(FATAL_ERROR "_cmake_generic_build_infrastructure_cpu_options：余分な引数が指定されています")
	endif()
	set(options)
	if(NOT baseline STREQUAL "")
		if(NOT baseline MATCHES "^(x86-64-v3|armv8.2-a)$")
			message(FATAL_ERROR "CPU_BASELINE：対応していない値です：${baseline}")
		endif()
		if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
			if(baseline STREQUAL "x86-64-v3")
				set(options /arch:AVX2)
			else()
				set(options /arch:armv8.2)
			endif()
		elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
			set(options "/clang:-march=${baseline}")
		elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|GNU)$" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
			set(options "-march=${baseline}")
		else()
			message(FATAL_ERROR "CPU_BASELINE：このコンパイラは対応していません")
		endif()
	endif()
	if(enable_avx2 AND NOT baseline STREQUAL "x86-64-v3")
		if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
			list(APPEND options /arch:AVX2)
		elseif(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
			list(APPEND options -mavx2)
		else()
			message(FATAL_ERROR "ENABLE_AVX2：このコンパイラフロントエンドは対応していません")
		endif()
	endif()
	set("${output}" "${options}" PARENT_SCOPE)
endfunction()

# 局所的なCPU設定だけを非公開で適用する。全体のbaselineはtoolchainが設定する
function(cmake_generic_build_infrastructure_apply_cpu_settings)
	cmake_parse_arguments(PARSE_ARGN arg "" "TARGET;CPU_BASELINE;ENABLE_AVX2" "")
	if(DEFINED arg_UNPARSED_ARGUMENTS OR DEFINED arg_KEYWORDS_MISSING_VALUES OR
		NOT DEFINED arg_TARGET OR arg_TARGET STREQUAL "")
		message(FATAL_ERROR "cmake_generic_build_infrastructure_apply_cpu_settings：TARGET <target>と有効なCPU設定を指定してください")
	endif()
	_cmake_generic_build_infrastructure_validate_target(cmake_generic_build_infrastructure_apply_cpu_settings "${arg_TARGET}")
	_cmake_generic_build_infrastructure_cpu_options(cpu_options "${arg_CPU_BASELINE}" "${arg_ENABLE_AVX2}")
	if(cpu_options)
		# 未対応オプションを警告だけで無視するコンパイラも拒否する
		include(CheckCXXCompilerFlag)
		string(SHA256 key "${CMAKE_CXX_COMPILER};${CMAKE_CXX_COMPILER_TARGET};${cpu_options}")
		set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
		check_cxx_compiler_flag("${cpu_options}" "GENERIC_BUILD_INFRASTRUCTURE_CPU_FLAG_${key}")
		if(NOT GENERIC_BUILD_INFRASTRUCTURE_CPU_FLAG_${key})
			message(FATAL_ERROR "CPU設定：コンパイラが${cpu_options}に対応していません。CMakeConfigureLog.yamlを確認してください")
		endif()
	endif()
	target_compile_options("${arg_TARGET}" PRIVATE ${cpu_options})
endfunction()
