cmake_minimum_required(VERSION 4.5)
foreach(required IN ITEMS CHECK_BINARY_DIR CHECK_COMPILER CHECK_ARCH)
	if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
		message(FATAL_ERROR "${required}を指定してください")
	endif()
endforeach()
cmake_path(CONVERT "${CHECK_BINARY_DIR}" TO_CMAKE_PATH_LIST CHECK_BINARY_DIR NORMALIZE)
set(source_dir "${CHECK_BINARY_DIR}/source")
file(MAKE_DIRECTORY "${source_dir}/dependency")
set(cpu_module "${CMAKE_CURRENT_LIST_DIR}/../../cmake/generic-build-infrastructure/CxxGenericBuildInfrastructureCPU.cmake")
file(CONFIGURE OUTPUT "${source_dir}/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 4.5)
project(CpuBaselineChecks LANGUAGES CXX)
include("@cpu_module@")
_cmake_generic_build_infrastructure_cpu_options(expected "${TEST_BASELINE}" OFF)
if(CGBI_CPU_BASELINE)
	separate_arguments(flags NATIVE_COMMAND "${CMAKE_CXX_FLAGS}")
	set(count 0)
	foreach(flag IN LISTS flags)
		if(flag IN_LIST expected)
			math(EXPR count "${count} + 1")
		endif()
	endforeach()
	if(NOT count EQUAL 1)
		message(FATAL_ERROR "全体CPU baselineが一度だけ設定されていません：${CMAKE_CXX_FLAGS}")
	endif()
	if(NOT CMAKE_CXX_FLAGS MATCHES "CPU_INIT_SENTINEL")
		message(FATAL_ERROR "既存のフラグ初期値が失われました")
	endif()
	include(CheckCXXSourceCompiles)
	if(TEST_BASELINE STREQUAL "x86-64-v3")
		set(source "#ifndef __AVX2__\n#error CPU baseline missing\n#endif\nint main() { return 0; }")
	else()
		set(source "int main() { return 0; }")
	endif()
	check_cxx_source_compiles("${source}" CPU_BASELINE_TRY_COMPILE)
	if(NOT CPU_BASELINE_TRY_COMPILE)
		message(FATAL_ERROR "全体CPU baselineが試験コンパイルへ届いていません")
	endif()
elseif(CMAKE_CXX_FLAGS MATCHES "(-march=|/arch:|/clang:-march=)")
	message(FATAL_ERROR "未指定の全体CPU baselineが適用されています")
endif()
add_library(main_target STATIC main.cpp)
add_subdirectory(dependency)
if(TEST_LOCAL)
	set(flags_before "${CMAKE_CXX_FLAGS}")
	cmake_generic_build_infrastructure_apply_cpu_settings(TARGET main_target CPU_BASELINE "${TEST_BASELINE}")
	if(NOT CMAKE_CXX_FLAGS STREQUAL flags_before)
		message(FATAL_ERROR "局所設定が全体のフラグを変更しました")
	endif()
	get_target_property(options main_target COMPILE_OPTIONS)
	if(NOT expected IN_LIST options)
		message(FATAL_ERROR "局所CPU設定が適用されていません")
	endif()
endif()
get_target_property(dependency_options dependency COMPILE_OPTIONS)
if(dependency_options)
	message(FATAL_ERROR "局所設定が別targetへ漏れました")
endif()
if(CGBI_CPU_BASELINE OR TEST_LOCAL)
	if(TEST_BASELINE STREQUAL "x86-64-v3")
		target_compile_definitions(main_target PRIVATE EXPECT_AVX2)
		if(CGBI_CPU_BASELINE)
			target_compile_definitions(dependency PRIVATE EXPECT_AVX2)
		endif()
	endif()
endif()
]=] @ONLY)
file(WRITE "${source_dir}/main.cpp" "#if defined(EXPECT_AVX2) && !defined(__AVX2__)\n#error CPU baseline missing\n#endif\nint answer() { return 42; }\n")
file(WRITE "${source_dir}/dependency/CMakeLists.txt" "add_library(dependency STATIC ../main.cpp)\n")
if(CHECK_ARCH MATCHES "^(aarch64|ARM64|arm64)$")
	set(baseline armv8.2-a)
	set(processor aarch64)
else()
	set(baseline x86-64-v3)
	set(processor x86_64)
endif()
set(toolchain "${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/${CMAKE_HOST_SYSTEM_NAME}.cmake")
foreach(case IN ITEMS enabled empty local unknown override-conflict)
	set(selected_baseline "")
	set(extra)
	set(expected_error "")
	if(case STREQUAL "enabled")
		set(selected_baseline "${baseline}")
	elseif(case STREQUAL "local")
		list(APPEND extra -DTEST_LOCAL=ON)
	elseif(case STREQUAL "unknown")
		set(selected_baseline invalid)
		set(expected_error "CPU_BASELINE：対応していない値です")
	elseif(case STREQUAL "override-conflict")
		set(selected_baseline "${baseline}")
		list(APPEND extra "-DCMAKE_USER_MAKE_RULES_OVERRIDE_CXX=${source_dir}/custom.cmake")
		set(expected_error "CGBI_CPU_BASELINEと独自のCMAKE_USER_MAKE_RULES_OVERRIDE_CXXは併用できません")
	endif()
	execute_process(
		ENCODING UTF-8
		COMMAND "${CMAKE_COMMAND}" --fresh -S "${source_dir}" -B "${CHECK_BINARY_DIR}/${case}" -G Ninja
			"-DCMAKE_TOOLCHAIN_FILE=${toolchain}" "-DCMAKE_CXX_COMPILER=${CHECK_COMPILER}"
			"-DCMAKE_SYSTEM_PROCESSOR=${processor}" "-DCGBI_CPU_BASELINE=${selected_baseline}"
			"-DTEST_BASELINE=${baseline}" "-DCMAKE_CXX_FLAGS_INIT=-DCPU_INIT_SENTINEL"
			${extra}
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	set(diagnostic "${output}\n${error}")
	string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic "${diagnostic}")
	if(NOT expected_error STREQUAL "")
		if(result STREQUAL "0" OR NOT diagnostic MATCHES "${expected_error}")
			message(FATAL_ERROR "${case}：想定した失敗ではありません：${diagnostic}")
		endif()
		continue()
	endif()
	if(NOT result STREQUAL "0")
		message(FATAL_ERROR "${case}のconfigureに失敗しました：${diagnostic}")
	endif()
	execute_process(
		COMMAND "${CMAKE_COMMAND}" -S "${source_dir}" -B "${CHECK_BINARY_DIR}/${case}"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	if(NOT result STREQUAL "0")
		message(FATAL_ERROR "${case}の再configureに失敗しました：${output}\n${error}")
	endif()
	execute_process(
		COMMAND "${CMAKE_COMMAND}" --build "${CHECK_BINARY_DIR}/${case}"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	if(NOT result STREQUAL "0")
		message(FATAL_ERROR "${case}のbuildに失敗しました：${output}\n${error}")
	endif()
endforeach()
message(STATUS "全体CPU baseline、依存target・試験コンパイルへの伝達、局所設定の分離を確認しました")
