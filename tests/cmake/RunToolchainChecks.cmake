if(DEFINED CHECK_CASE)
	if(CHECK_CASE STREQUAL "windows")
		set(CMAKE_HOST_SYSTEM_NAME Windows)
		set(CMAKE_HOST_SYSTEM_PROCESSOR AMD64)
		set(CMAKE_CXX_COMPILER clang-cl.exe)
		set(CMAKE_SYSTEM_PROCESSOR x86_64)
		set(expected_arch x86_64)
		if(MODE MATCHES "^(arm-cross|arm-native)$")
			set(CMAKE_SYSTEM_PROCESSOR aarch64)
			set(expected_arch aarch64)
		endif()
		if(MODE MATCHES "^(arm-native|x64-cross)$")
			set(CMAKE_HOST_SYSTEM_PROCESSOR ARM64)
		endif()
		if(MODE STREQUAL "invalid")
			set(CMAKE_SYSTEM_PROCESSOR OFF)
		elseif(MODE STREQUAL "conflict")
			set(CMAKE_CXX_COMPILER_TARGET aarch64-pc-windows-msvc)
		elseif(MODE STREQUAL "nonhost")
			set(CMAKE_HOST_SYSTEM_NAME Linux)
		elseif(MODE STREQUAL "amd64-alias")
			set(CMAKE_SYSTEM_PROCESSOR AMD64)
		elseif(MODE STREQUAL "arm64-alias")
			set(CMAKE_SYSTEM_PROCESSOR ARM64)
			set(CMAKE_HOST_SYSTEM_PROCESSOR ARM64)
			set(expected_arch aarch64)
		elseif(MODE STREQUAL "unspecified")
			unset(CMAKE_SYSTEM_PROCESSOR)
		endif()
		include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/Windows.cmake")
		if(MODE STREQUAL "unspecified")
			if(DEFINED CMAKE_CXX_COMPILER_TARGET OR DEFINED CMAKE_SYSTEM_NAME OR DEFINED CMAKE_SYSTEM_PROCESSOR)
				message(FATAL_ERROR "標的を指定していない場合はコンパイラの既定値に委譲してください")
			endif()
			return()
		endif()
		if(NOT CMAKE_CXX_COMPILER_TARGET STREQUAL "${expected_arch}-pc-windows-msvc")
			message(FATAL_ERROR "Windowsのコンパイラ標的が引き継がれていません")
		endif()
		if(MODE MATCHES "^(arm-cross|x64-cross)$")
			if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
				message(FATAL_ERROR "Windowsのクロス標的のシステムが引き継がれていません")
			endif()
			if(MODE STREQUAL "arm-cross")
				set(expected_processor ARM64)
			else()
				set(expected_processor AMD64)
			endif()
			if(NOT CMAKE_SYSTEM_PROCESSOR STREQUAL expected_processor)
				message(FATAL_ERROR "Windowsのクロス標的のプロセッサが引き継がれていません")
			endif()
		elseif(DEFINED CMAKE_SYSTEM_NAME)
			message(FATAL_ERROR "ネイティブ用ツールチェーンで標的システムは設定されません")
		endif()
		if(DEFINED compiler_name OR DEFINED target_triple OR DEFINED host_processor OR
			DEFINED target_arch OR DEFINED processor)
			message(FATAL_ERROR "Windows用ツールチェーンの一時変数が外部に漏れています")
		endif()
		return()
	elseif(CHECK_CASE STREQUAL "emscripten")
		include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/Emscripten.cmake")
	elseif(CHECK_CASE STREQUAL "wasi")
		include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/WASI.cmake")
	else()
		message(FATAL_ERROR "不明なCHECK_CASEです")
	endif()
	if(NOT SDK_SENTINEL STREQUAL "loaded")
		message(FATAL_ERROR "includeの前後でSDKの通常変数が保持されていません")
	endif()
	return()
endif()

if(NOT DEFINED CHECK_BINARY_DIR OR NOT IS_ABSOLUTE "${CHECK_BINARY_DIR}")
	message(FATAL_ERROR "CHECK_BINARY_DIRには絶対パスを指定してください")
endif()

# fixture用toolchainでは委譲と変数スコープを検証する
file(MAKE_DIRECTORY "${CHECK_BINARY_DIR}/emscripten/cmake/Modules/Platform")
file(MAKE_DIRECTORY "${CHECK_BINARY_DIR}/wasi/share/cmake")
file(WRITE "${CHECK_BINARY_DIR}/emscripten/cmake/Modules/Platform/Emscripten.cmake"
	"set(SDK_SENTINEL loaded)\n")
file(WRITE "${CHECK_BINARY_DIR}/wasi/share/cmake/wasi-sdk.cmake"
	"set(SDK_SENTINEL loaded)\n")

foreach(case IN ITEMS emscripten wasi)
	if(case STREQUAL "emscripten")
		set(root_variable EMSCRIPTEN_ROOT)
		set(expected "Emscripten SDKが見つかりません")
	else()
		set(root_variable WASI_SDK_PATH)
		set(expected "WASI SDKが見つかりません")
	endif()
	foreach(mode IN ITEMS valid environment missing)
		if(mode STREQUAL "valid" OR mode STREQUAL "environment")
			set(root "${CHECK_BINARY_DIR}/${case}")
		else()
			set(root "${CHECK_BINARY_DIR}/absent-${case}")
		endif()
		if(mode STREQUAL "environment")
			set(root_argument "")
			if(case STREQUAL "emscripten")
				set(environment "EMSCRIPTEN=set:${root}")
			else()
				set(environment "WASI_SDK_PATH=set:${root}")
			endif()
		else()
			set(root_argument "-D${root_variable}=${root}")
			set(environment "")
		endif()
		execute_process(
			ENCODING UTF-8
			COMMAND "${CMAKE_COMMAND}" "-DCHECK_CASE=${case}" ${root_argument}
				-P "${CMAKE_CURRENT_LIST_FILE}"
			ENVIRONMENT "EMSDK=${CHECK_BINARY_DIR}/absent-environment-sdk"
			ENVIRONMENT_MODIFICATION "EMSCRIPTEN=unset:" "EMSDK=unset:" "WASI_SDK_PATH=unset:"
				${environment}
			RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
		)
		set(diagnostic "${output}\n${error}")
		string(REGEX REPLACE "[ \t\r\n]+" " " normalized_diagnostic "${diagnostic}")
		if(mode STREQUAL "valid" OR mode STREQUAL "environment")
			if(NOT result EQUAL 0)
				message(FATAL_ERROR "${case}：ツールチェーンへの委譲に失敗しました：\n${diagnostic}")
			endif()
		elseif(result EQUAL 0 OR NOT normalized_diagnostic MATCHES "${expected}")
			message(FATAL_ERROR "${case}：SDK未検出の診断に失敗しました：\n${diagnostic}")
		endif()
	endforeach()
endforeach()
foreach(mode IN ITEMS x64-native arm-native arm-cross x64-cross amd64-alias arm64-alias unspecified invalid conflict nonhost)
	execute_process(
		ENCODING UTF-8
		COMMAND "${CMAKE_COMMAND}" -DCHECK_CASE=windows "-DMODE=${mode}"
			-P "${CMAKE_CURRENT_LIST_FILE}"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	set(diagnostic "${output}\n${error}")
	string(REGEX REPLACE "[ \t\r\n]+" " " normalized_diagnostic "${diagnostic}")
	if(mode STREQUAL "invalid")
		set(expected "対応なされていない値です")
	elseif(mode STREQUAL "conflict")
		set(expected "Windowsの標的アーキテクチャが競合しています")
	elseif(mode STREQUAL "nonhost")
		set(expected "ホストOSがWindowsである必要があります")
	else()
		set(expected "")
	endif()
	if(expected STREQUAL "")
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "Windows ${mode}のテストに失敗しました：\n${diagnostic}")
		endif()
	elseif(result EQUAL 0 OR NOT normalized_diagnostic MATCHES "${expected}")
		message(FATAL_ERROR "Windows ${mode}：'${expected}'というエラーが期待されました：\n${diagnostic}")
	endif()
endforeach()
message(STATUS "SDKへの委譲、変数スコープ、SDK未検出時の診断を確認しました")
