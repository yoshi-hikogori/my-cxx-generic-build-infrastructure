cmake_minimum_required(VERSION 4.5)

if(DEFINED CHECK_CASE)
	if(CHECK_CASE STREQUAL "windows")
		set(CMAKE_HOST_SYSTEM_NAME Windows)
		set(CMAKE_HOST_SYSTEM_PROCESSOR AMD64)
		set(CMAKE_CXX_COMPILER clang-cl.exe)
		set(CMAKE_SYSTEM_PROCESSOR x86_64)
		set(expected_arch x86_64)
		if(MODE MATCHES "^(arm-cross|arm-native)$")
			set(CMAKE_SYSTEM_PROCESSOR aarch64)
			set(expected_arch aarch64)
		endif()
		if(MODE MATCHES "^(arm-native|x64-cross)$")
			set(CMAKE_HOST_SYSTEM_PROCESSOR ARM64)
		endif()
		if(MODE STREQUAL "invalid")
			set(CMAKE_SYSTEM_PROCESSOR OFF)
		elseif(MODE STREQUAL "conflict")
			set(CMAKE_CXX_COMPILER_TARGET aarch64-pc-windows-msvc)
		elseif(MODE STREQUAL "nonhost")
			set(CMAKE_HOST_SYSTEM_NAME Linux)
		elseif(MODE STREQUAL "amd64-alias")
			set(CMAKE_SYSTEM_PROCESSOR AMD64)
		elseif(MODE STREQUAL "arm64-alias")
			set(CMAKE_SYSTEM_PROCESSOR ARM64)
			set(CMAKE_HOST_SYSTEM_PROCESSOR ARM64)
			set(expected_arch aarch64)
		elseif(MODE STREQUAL "unspecified")
			unset(CMAKE_SYSTEM_PROCESSOR)
		elseif(MODE STREQUAL "environment")
			set(CGBI_TARGET_ENVIRONMENT msvc)
		elseif(MODE STREQUAL "environment-invalid")
			set(CGBI_TARGET_ENVIRONMENT gnu)
		endif()
		include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/Windows.cmake")
		if(MODE STREQUAL "unspecified")
			if(DEFINED CMAKE_CXX_COMPILER_TARGET OR DEFINED CMAKE_SYSTEM_NAME OR DEFINED CMAKE_SYSTEM_PROCESSOR)
				message(FATAL_ERROR "標的を指定していない場合はコンパイラの既定値に委譲してください")
			endif()
			return()
		endif()
		if(NOT CMAKE_CXX_COMPILER_TARGET STREQUAL "${expected_arch}-pc-windows-msvc")
			message(FATAL_ERROR "Windowsのコンパイラ標的が引き継がれていません")
		endif()
		if(MODE MATCHES "^(arm-cross|x64-cross)$")
			if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
				message(FATAL_ERROR "Windowsのクロス標的のシステムが引き継がれていません")
			endif()
			if(MODE STREQUAL "arm-cross")
				set(expected_processor ARM64)
			else()
				set(expected_processor AMD64)
			endif()
			if(NOT CMAKE_SYSTEM_PROCESSOR STREQUAL expected_processor)
				message(FATAL_ERROR "Windowsのクロス標的のプロセッサが引き継がれていません")
			endif()
		elseif(DEFINED CMAKE_SYSTEM_NAME)
			message(FATAL_ERROR "ネイティブ用ツールチェーンで標的システムは設定されません")
		endif()
		if(DEFINED compiler_name OR DEFINED target_triple OR DEFINED host_processor OR
			DEFINED target_arch OR DEFINED processor)
			message(FATAL_ERROR "Windows用ツールチェーンの一時変数が外部に漏れています")
		endif()
		return()
	elseif(CHECK_CASE STREQUAL "linux")
		set(CMAKE_HOST_SYSTEM_NAME Linux)
		set(CMAKE_HOST_SYSTEM_PROCESSOR x86_64)
		set(CMAKE_SYSTEM_PROCESSOR x86_64)
		set(CGBI_TARGET_ENVIRONMENT gnu)
		set(CMAKE_CXX_COMPILER clang++)
		set(expected_arch x86_64)
		if(MODE STREQUAL "arm")
			set(CMAKE_HOST_SYSTEM_PROCESSOR aarch64)
			set(CMAKE_SYSTEM_PROCESSOR aarch64)
			set(expected_arch aarch64)
		elseif(MODE STREQUAL "alias")
			set(CMAKE_HOST_SYSTEM_PROCESSOR AMD64)
			set(CMAKE_SYSTEM_PROCESSOR x64)
		elseif(MODE STREQUAL "versioned-clang")
			set(CMAKE_CXX_COMPILER clang++-23)
		elseif(MODE STREQUAL "existing-target")
			set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-linux-gnu)
		elseif(MODE STREQUAL "conflict")
			set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-linux-musl)
		elseif(MODE STREQUAL "arch-conflict")
			set(CMAKE_CXX_COMPILER_TARGET aarch64-unknown-linux-gnu)
		elseif(MODE STREQUAL "invalid")
			set(CGBI_TARGET_ENVIRONMENT musl)
		elseif(MODE STREQUAL "arch-missing")
			unset(CMAKE_SYSTEM_PROCESSOR)
		elseif(MODE STREQUAL "cross")
			set(CMAKE_SYSTEM_PROCESSOR aarch64)
		elseif(MODE STREQUAL "nonhost")
			set(CMAKE_HOST_SYSTEM_NAME Windows)
		elseif(MODE STREQUAL "unsupported")
			set(CMAKE_CXX_COMPILER other-compiler)
		elseif(MODE STREQUAL "unspecified")
			set(CGBI_TARGET_ENVIRONMENT "")
			unset(CMAKE_SYSTEM_PROCESSOR)
		endif()
		if(MODE MATCHES "^gcc")
			set(CMAKE_CXX_COMPILER g++)
			set(reported_triple x86_64-linux-gnu)
			if(MODE STREQUAL "gcc-prefixed")
				set(CMAKE_CXX_COMPILER x86_64-linux-gnu-g++-14)
			elseif(MODE STREQUAL "gcc-vendor")
				set(reported_triple x86_64-redhat-linux-gnu)
			elseif(MODE STREQUAL "gcc-arm")
				set(CMAKE_HOST_SYSTEM_PROCESSOR aarch64)
				set(CMAKE_SYSTEM_PROCESSOR ARM64)
				set(expected_arch aarch64)
				set(reported_triple aarch64-linux-gnu)
			elseif(MODE STREQUAL "gcc-musl")
				set(reported_triple x86_64-linux-musl)
			elseif(MODE STREQUAL "gcc-wrong-arch")
				set(reported_triple aarch64-linux-gnu)
			elseif(MODE STREQUAL "gcc-empty")
				set(reported_triple "")
			elseif(MODE STREQUAL "gcc-target")
				set(CMAKE_CXX_COMPILER_TARGET x86_64-linux-gnu)
			endif()
			# GCCのプロセス境界だけをfixtureに置き換える
			function(find_program output)
				if(NOT ARGN STREQUAL "NAMES;${CMAKE_CXX_COMPILER};NO_CACHE;NO_CMAKE_FIND_ROOT_PATH;REQUIRED")
					message(FATAL_ERROR "指定されたGCC以外を探索しています：${ARGN}")
				endif()
				set("${output}" "${CMAKE_CURRENT_LIST_DIR}/${CMAKE_CXX_COMPILER}" PARENT_SCOPE)
			endfunction()
			function(execute_process)
				cmake_parse_arguments(PARSE_ARGV 0 process "OUTPUT_STRIP_TRAILING_WHITESPACE"
					"RESULT_VARIABLE;OUTPUT_VARIABLE;ERROR_VARIABLE" "COMMAND")
				if(NOT process_COMMAND STREQUAL "${CMAKE_CXX_COMPILER};-dumpmachine")
					message(FATAL_ERROR "GCCの標的問い合わせが想定と異なります：${process_COMMAND}")
				endif()
				if(MODE STREQUAL "gcc-failed")
					set("${process_RESULT_VARIABLE}" 1 PARENT_SCOPE)
					set("${process_ERROR_VARIABLE}" "fixture failure" PARENT_SCOPE)
				else()
					set("${process_RESULT_VARIABLE}" 0 PARENT_SCOPE)
				endif()
				set("${process_OUTPUT_VARIABLE}" "${reported_triple}" PARENT_SCOPE)
			endfunction()
		endif()
		include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/Linux.cmake")
		if(NOT "CGBI_TARGET_ENVIRONMENT" IN_LIST CMAKE_TRY_COMPILE_PLATFORM_VARIABLES)
			message(FATAL_ERROR "environment入力がtry_compileへ引き継がれません")
		endif()
		if(NOT "CMAKE_SYSTEM_PROCESSOR" IN_LIST CMAKE_TRY_COMPILE_PLATFORM_VARIABLES)
			message(FATAL_ERROR "architecture入力がtry_compileへ引き継がれません")
		endif()
		if(MODE STREQUAL "unspecified" OR MODE MATCHES "^gcc")
			if(DEFINED CMAKE_CXX_COMPILER_TARGET)
				message(FATAL_ERROR "未指定環境・GCCにはcompiler targetを追加しないでください")
			endif()
		elseif(NOT CMAKE_CXX_COMPILER_TARGET MATCHES "^${expected_arch}-([^-]+-)?linux-gnu$")
			message(FATAL_ERROR "Clangへ標的tripleが引き継がれていません")
		endif()
		if(DEFINED CMAKE_SYSTEM_NAME OR DEFINED compiler_name OR DEFINED target_arch OR DEFINED triple)
			message(FATAL_ERROR "Linux native toolchainの設定・変数スコープが想定と異なります")
		endif()
		return()
	elseif(CHECK_CASE STREQUAL "emscripten")
		include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/Emscripten.cmake")
	elseif(CHECK_CASE STREQUAL "wasi")
		include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/WASI.cmake")
	else()
		message(FATAL_ERROR "不明なCHECK_CASEです")
	endif()
	if(NOT SDK_SENTINEL STREQUAL "loaded")
		message(FATAL_ERROR "includeの前後でSDKの通常変数が保持されていません")
	endif()
	return()
endif()

if(NOT DEFINED CHECK_BINARY_DIR OR NOT IS_ABSOLUTE "${CHECK_BINARY_DIR}")
	message(FATAL_ERROR "CHECK_BINARY_DIRには絶対パスを指定してください")
endif()
cmake_path(CONVERT "${CHECK_BINARY_DIR}" TO_CMAKE_PATH_LIST CHECK_BINARY_DIR NORMALIZE)

# fixture用toolchainでは委譲と変数スコープを検証する
file(MAKE_DIRECTORY "${CHECK_BINARY_DIR}/emscripten/cmake/Modules/Platform")
file(MAKE_DIRECTORY "${CHECK_BINARY_DIR}/wasi/share/cmake")
file(WRITE "${CHECK_BINARY_DIR}/emscripten/cmake/Modules/Platform/Emscripten.cmake"
	"set(SDK_SENTINEL loaded)\n")
file(WRITE "${CHECK_BINARY_DIR}/wasi/share/cmake/wasi-sdk.cmake"
	"set(SDK_SENTINEL loaded)\n")

foreach(case IN ITEMS emscripten wasi)
	if(case STREQUAL "emscripten")
		set(root_variable EMSCRIPTEN_ROOT)
		set(expected "Emscripten SDKが見つかりません")
	else()
		set(root_variable WASI_SDK_PATH)
		set(expected "WASI SDKが見つかりません")
	endif()
	foreach(mode IN ITEMS valid environment missing target-environment)
		set(target_environment)
		if(mode STREQUAL "target-environment")
			set(target_environment -DCGBI_TARGET_ENVIRONMENT=gnu)
		endif()
		if(mode STREQUAL "valid" OR mode STREQUAL "environment")
			set(root "${CHECK_BINARY_DIR}/${case}")
		else()
			set(root "${CHECK_BINARY_DIR}/absent-${case}")
		endif()
		if(mode STREQUAL "environment")
			set(root_argument "")
			if(case STREQUAL "emscripten")
				set(environment "EMSCRIPTEN=set:${root}")
			else()
				set(environment "WASI_SDK_PATH=set:${root}")
			endif()
		else()
			set(root_argument "-D${root_variable}=${root}")
			set(environment "")
		endif()
		execute_process(
			ENCODING UTF-8
			COMMAND "${CMAKE_COMMAND}" "-DCHECK_CASE=${case}" ${root_argument} ${target_environment}
				-P "${CMAKE_CURRENT_LIST_FILE}"
			ENVIRONMENT "EMSDK=${CHECK_BINARY_DIR}/absent-environment-sdk"
			ENVIRONMENT_MODIFICATION "EMSCRIPTEN=unset:" "EMSDK=unset:" "WASI_SDK_PATH=unset:"
				${environment}
			RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
		)
		set(diagnostic "${output}\n${error}")
		string(REGEX REPLACE "[ \t\r\n]+" " " normalized_diagnostic "${diagnostic}")
		if(mode STREQUAL "valid" OR mode STREQUAL "environment")
			if(NOT result EQUAL 0)
				message(FATAL_ERROR "${case}：ツールチェーンへの委譲に失敗しました：\n${diagnostic}")
			endif()
		elseif(mode STREQUAL "target-environment")
			if(result EQUAL 0 OR NOT normalized_diagnostic MATCHES "標的の選択はSDKに委譲してください")
				message(FATAL_ERROR "${case}：environment指定が無視されました：\n${diagnostic}")
			endif()
		elseif(result EQUAL 0 OR NOT normalized_diagnostic MATCHES "${expected}")
			message(FATAL_ERROR "${case}：SDK未検出の診断に失敗しました：\n${diagnostic}")
		endif()
	endforeach()
endforeach()
foreach(mode IN ITEMS x64-native arm-native arm-cross x64-cross amd64-alias arm64-alias unspecified invalid conflict nonhost environment environment-invalid)
	execute_process(
		ENCODING UTF-8
		COMMAND "${CMAKE_COMMAND}" -DCHECK_CASE=windows "-DMODE=${mode}"
			-P "${CMAKE_CURRENT_LIST_FILE}"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	set(diagnostic "${output}\n${error}")
	string(REGEX REPLACE "[ \t\r\n]+" " " normalized_diagnostic "${diagnostic}")
	if(mode STREQUAL "invalid")
		set(expected "サポートされていない値です")
	elseif(mode STREQUAL "conflict")
		set(expected "Windowsのターゲットアーキテクチャが競合しています")
	elseif(mode STREQUAL "environment-invalid")
		set(expected "CGBI_TARGET_ENVIRONMENT：Windows.cmakeでサポートされていない値です")
	elseif(mode STREQUAL "nonhost")
		set(expected "ホストOSがWindowsである必要があります")
	else()
		set(expected "")
	endif()
	if(expected STREQUAL "")
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "Windows ${mode}のテストに失敗しました：\n${diagnostic}")
		endif()
	elseif(result EQUAL 0 OR NOT normalized_diagnostic MATCHES "${expected}")
		message(FATAL_ERROR "Windows ${mode}：'${expected}'というエラーが期待されました：\n${diagnostic}")
	endif()
endforeach()
foreach(mode IN ITEMS native arm alias versioned-clang existing-target unspecified
	gcc gcc-prefixed gcc-vendor gcc-arm gcc-musl gcc-wrong-arch gcc-empty gcc-failed gcc-target
	conflict arch-conflict invalid arch-missing cross nonhost unsupported)
	execute_process(
		ENCODING UTF-8
		COMMAND "${CMAKE_COMMAND}" -DCHECK_CASE=linux "-DMODE=${mode}" -P "${CMAKE_CURRENT_LIST_FILE}"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	set(diagnostic "${output}\n${error}")
	string(REGEX REPLACE "[ \t\r\n]+" " " normalized_diagnostic "${diagnostic}")
	set(expected "")
	if(mode MATCHES "^(conflict|arch-conflict)$")
		set(expected "Linuxの標的指定が競合しています")
	elseif(mode MATCHES "^gcc-(musl|wrong-arch|empty)$")
		set(expected "GCCの標的tripleとLinuxの標的指定が一致しません")
	elseif(mode STREQUAL "gcc-failed")
		set(expected "GCCの標的tripleを取得できません")
	elseif(mode STREQUAL "gcc-target")
		set(expected "CMAKE_CXX_COMPILER_TARGETは使用できません")
	elseif(mode STREQUAL "invalid")
		set(expected "Linux.cmakeでサポートされていない値です")
	elseif(mode STREQUAL "arch-missing")
		set(expected "targetのarchitectureを指定できません")
	elseif(mode MATCHES "^(cross|nonhost)$")
		set(expected "専用のSDKツールチェーンが必要です")
	elseif(mode STREQUAL "unsupported")
		set(expected "ClangまたはGCCのC\\+\\+ドライバを指定してください")
	endif()
	if(expected STREQUAL "")
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "Linux ${mode}のテストに失敗しました：\n${diagnostic}")
		endif()
	elseif(result EQUAL 0 OR NOT normalized_diagnostic MATCHES "${expected}")
		message(FATAL_ERROR "Linux ${mode}：'${expected}'というエラーが期待されました：\n${diagnostic}")
	endif()
endforeach()

# SDKなしでコンパイルできるソースでClangへの伝達とnested try_compileを検証する
find_program(check_clang NAMES clang++ clang++.exe)
find_program(check_archiver NAMES llvm-ar llvm-ar.exe ar)
if(check_clang AND check_archiver)
	set(linux_fixture "${CHECK_BINARY_DIR}/linux-driver")
	file(MAKE_DIRECTORY "${linux_fixture}")
	set(linux_toolchain "${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/Linux.cmake")
	file(CONFIGURE OUTPUT "${linux_fixture}/toolchain.cmake" CONTENT [=[
set(CMAKE_HOST_SYSTEM_NAME Linux)
set(CMAKE_HOST_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_AR "@check_archiver@")
if(NOT CGBI_TARGET_ENVIRONMENT STREQUAL "gnu" OR NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64" OR
	NOT CGBI_CPU_BASELINE STREQUAL "x86-64-v3")
	message(FATAL_ERROR "Linux toolchainの標的入力が引き継がれていません")
endif()
include("@linux_toolchain@")
get_property(nested GLOBAL PROPERTY IN_TRY_COMPILE)
if(nested)
	file(APPEND "@linux_fixture@/nested-inputs.txt" "${CGBI_TARGET_ENVIRONMENT};${CMAKE_SYSTEM_PROCESSOR};${CGBI_CPU_BASELINE}\n")
endif()
]=] @ONLY)
	file(WRITE "${linux_fixture}/main.cpp"
		"#if !defined(__linux__) || !defined(__x86_64__) || !defined(__AVX2__)\n#error Wrong compiler target or CPU baseline\n#endif\nint answer() { return 42; }\n")
	file(WRITE "${linux_fixture}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 4.5)
project(LinuxTargetDriver LANGUAGES CXX)
if(NOT CMAKE_CXX_COMPILER_TARGET STREQUAL "x86_64-unknown-linux-gnu")
	message(FATAL_ERROR "Clang compiler targetが設定されていません")
endif()
include(CheckCXXSourceCompiles)
check_cxx_source_compiles("#if !defined(__linux__) || !defined(__x86_64__) || !defined(__AVX2__)\n#error Wrong target or CPU baseline\n#endif\nint main() { return 0; }" TARGET_INPUTS_WORK)
if(NOT TARGET_INPUTS_WORK)
	message(FATAL_ERROR "Linux標的の試験コンパイルに失敗しました")
endif()
add_library(target_driver STATIC main.cpp)
]=])
	file(REMOVE "${linux_fixture}/nested-inputs.txt")
	execute_process(
		ENCODING UTF-8
		COMMAND "${CMAKE_COMMAND}" --fresh -S "${linux_fixture}" -B "${linux_fixture}/build" -G Ninja
			"-DCMAKE_TOOLCHAIN_FILE=${linux_fixture}/toolchain.cmake"
			"-DCMAKE_CXX_COMPILER=${check_clang}"
			-DCGBI_TARGET_ENVIRONMENT=gnu -DCMAKE_SYSTEM_PROCESSOR=x86_64 -DCGBI_CPU_BASELINE=x86-64-v3
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	if(NOT result STREQUAL "0")
		message(FATAL_ERROR "Linux標的driver fixtureのconfigureに失敗しました：\n${output}\n${error}")
	endif()
	if(NOT EXISTS "${linux_fixture}/nested-inputs.txt")
		message(FATAL_ERROR "Linux標的driver fixtureでnested try_compileが実行されていません")
	endif()
	execute_process(
		ENCODING UTF-8
		COMMAND "${CMAKE_COMMAND}" --build "${linux_fixture}/build"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	if(NOT result STREQUAL "0")
		message(FATAL_ERROR "Linux標的driver fixtureのビルドに失敗しました：\n${output}\n${error}")
	endif()
else()
	message(STATUS "Clang/archiver未検出のためLinux標的driver fixtureは未検証です")
endif()
message(STATUS "標的入力の伝達、GCC標的照合、SDKへの委譲、変数スコープ、失敗時の診断を確認しました")
