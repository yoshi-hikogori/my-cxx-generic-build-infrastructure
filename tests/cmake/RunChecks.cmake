foreach(required IN ITEMS CHECK_BINARY_DIR CHECK_COMPILER)
	if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
		message(FATAL_ERROR "${required}を指定してください")
	endif()
endforeach()
if(NOT DEFINED CHECK_ARCH OR CHECK_ARCH STREQUAL "")
	set(CHECK_ARCH x86_64)
endif()

foreach(case IN ITEMS generic generic-output generic-platform generic-output-invalid generic-platform-unknown generic-cpu-missing generic-cpu-invalid generic-generator-invalid generic-trace-missing generic-instrumentation-invalid valid avx2 cpu-valid cpu-option-matrix cpu-conflict cpu-avx2-conflict cpu-unknown cpu-unsupported arch-unknown arch-mismatch env-unknown env-mismatch env-glibc instrumentation false-target alias false-alias non-x86 missing missing-value unknown false-unknown nonexistent imported imported-alias interface interface-alias custom pdb-missing pdb-unknown pdb-false-unknown pdb-missing-value pdb-relative empty-extra diagnostic-scope diagnostic-install diagnostic-non-target)
	set(compiler_target)
	if(DEFINED CHECK_COMPILER_TARGET AND NOT CHECK_COMPILER_TARGET STREQUAL "")
		list(APPEND compiler_target "-DCMAKE_CXX_COMPILER_TARGET=${CHECK_COMPILER_TARGET}")
	endif()
	execute_process(
		ENCODING UTF-8
		COMMAND "${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}"
			-B "${CHECK_BINARY_DIR}/${case}" -G Ninja
			"-DCMAKE_CXX_COMPILER=${CHECK_COMPILER}" "-DCASE=${case}"
			"-DCHECK_ARCH=${CHECK_ARCH}" ${compiler_target}
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
	)
	set(diagnostic "${output}\n${error}")
	string(REGEX REPLACE "[ \t\r\n]+" " " normalized_diagnostic "${diagnostic}")
	if(case MATCHES "^(generic|generic-output|generic-platform|valid|avx2|cpu-valid|cpu-option-matrix|instrumentation|false-target|alias|false-alias|diagnostic-scope)$" OR
		(case STREQUAL "env-glibc" AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux"))
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "${case}に失敗しました：\n${diagnostic}")
		endif()
	else()
		if(case STREQUAL "generic-output-invalid")
			set(expected "ARCHIVE・LIBRARY・RUNTIMEには絶対パスを指定してください")
		elseif(case STREQUAL "generic-platform-unknown")
			set(expected "未知の引数または値の欠落があります")
		elseif(case STREQUAL "generic-cpu-missing")
			set(expected "TARGET <target>と有効なCPU設定を指定してください")
		elseif(case STREQUAL "generic-cpu-invalid")
			set(expected "TARGET_ARCH：対応していない値です")
		elseif(case STREQUAL "generic-generator-invalid")
			set(expected "NinjaまたはNinja Multi-Configが必要です")
		elseif(case STREQUAL "generic-instrumentation-invalid")
			set(expected "OUTPUT_DIRECTORYには絶対パスを指定してください")
		elseif(case MATCHES "^(non-x86|cpu-avx2-conflict)$")
			set(expected "標的にx86を指定してください")
		elseif(case STREQUAL "cpu-conflict")
			set(expected "CPU_BASELINEとTARGET_ARCHが競合しています")
		elseif(case MATCHES "^(cpu-unknown|arch-unknown|env-unknown)$")
			set(expected "対応していない値です")
		elseif(case STREQUAL "cpu-unsupported")
			set(expected "このコンパイラは対応していません")
		elseif(case MATCHES "^(arch-mismatch|env-glibc)$")
			set(expected "標的環境の検証に失敗しました")
		elseif(case STREQUAL "env-mismatch")
			set(expected "Linux/glibcが必要です")
		elseif(case STREQUAL "nonexistent")
			set(expected "ターゲットが存在しません")
		elseif(case MATCHES "^(imported|imported-alias|interface|interface-alias|custom)$")
			set(expected "ローカルのコンパイル可能なターゲット")
		elseif(case STREQUAL "pdb-relative")
			set(expected "OUTPUT_DIRECTORYには絶対パスを指定してください")
		elseif(case STREQUAL "empty-extra")
			set(expected "余分な引数が指定されています")
		elseif(case MATCHES "^pdb-(missing|unknown|false-unknown|missing-value)$")
			set(expected "TARGET <target>とOUTPUT_DIRECTORY <path>を指定してください")
		elseif(case STREQUAL "diagnostic-install")
			set(expected "install-absolute-destination")
		elseif(case STREQUAL "diagnostic-non-target")
			set(expected "non-target-directive")
		else()
			set(expected "TARGET <target>を指定してください")
		endif()
		if(result EQUAL 0 OR NOT normalized_diagnostic MATCHES "${expected}")
			message(FATAL_ERROR
				"【${case}】期待された失敗：${expected}\n実際の出力：\n${diagnostic}"
			)
		endif()
	endif()
	message(STATUS "ヘルパーのテストを確認しました: ${case}")
endforeach()
