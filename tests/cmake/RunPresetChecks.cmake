cmake_minimum_required(VERSION 4.5)
cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH tests_dir)
cmake_path(GET tests_dir PARENT_PATH source_dir)
set(axis_files
	"${source_dir}/cmake/presets/CMakeGenericBuildInfrastructurePresets.json"
	"${source_dir}/cmake/presets/CMakeProjectPresets.json"
)

function(check_members json allowed context)
	string(JSON count LENGTH "${json}")
	if(count EQUAL 0)
		return()
	endif()
	math(EXPR last "${count} - 1")
	foreach(index RANGE 0 ${last})
		string(JSON member MEMBER "${json}" ${index})
		if(NOT member IN_LIST allowed)
			message(FATAL_ERROR "${context}：想定外の設定です：${member}")
		endif()
	endforeach()
endfunction()

foreach(axes_file IN LISTS axis_files)
	file(READ "${axes_file}" axes)
	foreach(kind IN ITEMS configurePresets buildPresets testPresets packagePresets)
		string(JSON count LENGTH "${axes}" "${kind}")
		if(count EQUAL 0)
			continue()
		endif()
		math(EXPR last "${count} - 1")
		foreach(index RANGE 0 ${last})
			string(JSON preset GET "${axes}" "${kind}" ${index})
			string(JSON name GET "${preset}" name)
			if(kind STREQUAL "configurePresets")
				string(REGEX REPLACE "\\([^()]*\\)" "" axis_name "${name}")
				if(NOT axis_name MATCHES "^[A-Za-z_]+:[A-Za-z0-9_+.]+$")
					message(FATAL_ERROR "${kind}/${name}：axis:value形式で指定してください。各部品内の空白はアンダースコアにします")
				endif()
			endif()
			string(JSON hidden GET "${preset}" hidden)
			if(NOT hidden)
				message(FATAL_ERROR "${kind}/${name}：軸プリセットはhiddenにしてください")
			endif()
			set(allowed name hidden displayName description "$comment")
			set(cache_keys)
			if(kind STREQUAL "configurePresets")
				if(name MATCHES "^host:")
					list(APPEND allowed condition)
				elseif(name MATCHES "^layout:")
					list(APPEND allowed binaryDir installDir)
				elseif(name MATCHES "^system:")
					list(APPEND allowed toolchainFile)
					string(JSON toolchain GET "${preset}" toolchainFile)
					if(NOT toolchain MATCHES "^\\$\\{sourceDir\\}/cmake/toolchains/[A-Za-z]+\\.cmake$")
						message(FATAL_ERROR "${kind}/${name}：toolchainのパスはソースルート内の標準配置を基準にしてください")
					endif()
				elseif(name MATCHES "^generator:")
					list(APPEND allowed generator)
				elseif(name MATCHES "^architecture:")
					list(APPEND allowed architecture)
				elseif(name MATCHES "^toolset:")
					list(APPEND allowed toolset)
				elseif(name MATCHES "^diagnostics:")
					list(APPEND allowed warnings errors)
				elseif(name MATCHES "^debug:")
					list(APPEND allowed debug)
				elseif(name MATCHES "^trace:")
					list(APPEND allowed trace)
				elseif(name MATCHES "^build_type:")
					set(cache_keys CMAKE_BUILD_TYPE)
				elseif(name MATCHES "^default_build_type:")
					set(cache_keys CMAKE_DEFAULT_BUILD_TYPE)
				elseif(name MATCHES "^build_types:")
					set(cache_keys CMAKE_CONFIGURATION_TYPES)
				elseif(name MATCHES "^target_arch:")
					set(cache_keys MY_IMPORT_STD_TARGET_ARCH CMAKE_SYSTEM_PROCESSOR)
				elseif(name MATCHES "^cpu_type:")
					set(cache_keys MY_IMPORT_STD_CPU_BASELINE)
				elseif(name MATCHES "^target_environment:")
					set(cache_keys MY_IMPORT_STD_TARGET_ENVIRONMENT)
				elseif(name MATCHES "^compiler:")
					set(cache_keys CMAKE_CXX_COMPILER)
				elseif(name MATCHES "^linker:")
					set(cache_keys CMAKE_LINKER_TYPE)
				elseif(name STREQUAL "feature:ASan(compiler:clang_cl,build_type:Debug)")
					set(cache_keys CMAKE_CXX_FLAGS_DEBUG CMAKE_EXE_LINKER_FLAGS_DEBUG)
				elseif(name MATCHES "^feature:")
					set(cache_keys MY_IMPORT_STD_ENABLE_PCH MY_IMPORT_STD_BUILD_EXAMPLES
						MY_IMPORT_STD_ENABLE_AVX2 MY_IMPORT_STD_USE_STATIC_RUNTIME
						MY_IMPORT_STD_ENABLE_PACKAGING MY_IMPORT_STD_ENABLE_INSTRUMENTATION
						CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE)
				else()
					message(FATAL_ERROR "${kind}/${name}：軸の分類を判定できません")
				endif()
				if(axes_file MATCHES "CMakeGenericBuildInfrastructurePresets.json")
					set(generic_settings "${preset}")
					if(name MATCHES "^system:")
						string(JSON generic_settings REMOVE "${generic_settings}" toolchainFile)
					endif()
					if(preset MATCHES "MY_IMPORT_STD_" OR generic_settings MATCHES "\\$\\{sourceDir\\}")
						message(FATAL_ERROR "${axes_file}/${name}：汎用軸にプロジェクト固有の設定やパスを含めることはできません")
					endif()
				endif()
				if(cache_keys)
					list(APPEND allowed cacheVariables)
					string(JSON cache GET "${preset}" cacheVariables)
					check_members("${cache}" "${cache_keys}" "${kind}/${name}/cacheVariables")
					string(JSON cache_count LENGTH "${cache}")
					if(name MATCHES "^target_arch:")
						if(NOT cache_count EQUAL 2)
							message(FATAL_ERROR "${kind}/${name}：architectureの選択と案件の検証条件を接続してください")
						endif()
						string(JSON selected_arch GET "${cache}" MY_IMPORT_STD_TARGET_ARCH)
						string(JSON processor GET "${cache}" CMAKE_SYSTEM_PROCESSOR)
						if(NOT selected_arch STREQUAL processor)
							message(FATAL_ERROR "${kind}/${name}：標的の選択と検証条件が一致しません")
						endif()
					elseif(NOT name STREQUAL "feature:ASan(compiler:clang_cl,build_type:Debug)" AND NOT cache_count EQUAL 1)
						message(FATAL_ERROR "${kind}/${name}：軸で選択するキャッシュ設定は1つにしてください")
					endif()
				endif()
			elseif(kind STREQUAL "buildPresets" AND name MATCHES "^build-build_type:")
				list(APPEND allowed configuration)
			elseif(kind STREQUAL "buildPresets" AND name MATCHES "^(install-operation:|verify-checksum-operation:|build-prepare-operation:)")
				list(APPEND allowed targets)
			elseif(kind STREQUAL "testPresets" AND name MATCHES "^test-build_type:")
				list(APPEND allowed configuration)
			elseif(kind STREQUAL "testPresets" AND name MATCHES "^test-output:")
				list(APPEND allowed output)
			elseif(kind STREQUAL "packagePresets" AND name MATCHES "^package-build_type:")
				list(APPEND allowed configurations)
			elseif(kind STREQUAL "packagePresets" AND name MATCHES "^package-format:")
				list(APPEND allowed generators)
			else()
				message(FATAL_ERROR "${kind}/${name}：軸の分類を判定できません")
			endif()
			check_members("${preset}" "${allowed}" "${kind}/${name}")
		endforeach()
	endforeach()
endforeach()
foreach(preset_file IN ITEMS
	"${source_dir}/CMakePresets.json"
	"${source_dir}/cmake/presets/CMakeGenericBuildInfrastructurePresets.json"
	"${source_dir}/cmake/presets/CMakeProjectPresets.json"
	"${source_dir}/work/cmake-refactoring/CMakePresets.json"
)
	file(READ "${preset_file}" presets)
	string(JSON count LENGTH "${presets}" configurePresets)
	math(EXPR last "${count} - 1")
	foreach(index RANGE 0 ${last})
		string(JSON preset GET "${presets}" configurePresets ${index})
		string(JSON name GET "${preset}" name)
		set("configure_${name}" "${preset}")
		if(name MATCHES "^layout:")
			set(allowed name hidden description binaryDir installDir cacheVariables "$comment")
			check_members("${preset}" "${allowed}" "configurePresets/${name}")
			string(JSON cache_type ERROR_VARIABLE cache_error TYPE "${preset}" cacheVariables)
			if(cache_error STREQUAL "NOTFOUND")
				string(JSON cache GET "${preset}" cacheVariables)
				check_members("${cache}" "CPACK_PACKAGE_DIRECTORY" "configurePresets/${name}/cacheVariables")
			endif()
		endif()
	endforeach()
	foreach(kind IN ITEMS buildPresets testPresets packagePresets)
		string(JSON count LENGTH "${presets}" "${kind}")
		if(count EQUAL 0)
			continue()
		endif()
		math(EXPR last "${count} - 1")
		foreach(index RANGE 0 ${last})
			string(JSON name GET "${presets}" "${kind}" ${index} name)
			if(kind STREQUAL "buildPresets")
				set(prefix "^(build|install|verify-checksum)-")
			elseif(kind STREQUAL "testPresets")
				set(prefix "^test-")
			else()
				set(prefix "^package-")
			endif()
			if(NOT name MATCHES "${prefix}")
				message(FATAL_ERROR "${kind}/${name}：先頭に操作を表す接頭辞が必要です")
			endif()
		endforeach()
	endforeach()
endforeach()

function(resolve_configure_value preset_name setting output)
	set(variable "configure_${preset_name}")
	if(NOT DEFINED "${variable}")
		message(FATAL_ERROR "不明なconfigureプリセットです：${preset_name}")
	endif()
	set(preset "${${variable}}")
	if(setting MATCHES "^MY_IMPORT_STD_")
		string(JSON value ERROR_VARIABLE error GET "${preset}" cacheVariables "${setting}")
	else()
		string(JSON value ERROR_VARIABLE error GET "${preset}" "${setting}")
	endif()
	if(error STREQUAL "NOTFOUND")
		set("${output}" "${value}" PARENT_SCOPE)
		return()
	endif()
	string(JSON parents ERROR_VARIABLE error GET "${preset}" inherits)
	if(error STREQUAL "NOTFOUND")
		string(JSON parent_type TYPE "${preset}" inherits)
		if(parent_type STREQUAL "ARRAY")
			string(JSON count LENGTH "${parents}")
			math(EXPR last "${count} - 1")
			set(parent_names)
			foreach(index RANGE 0 ${last})
				string(JSON parent GET "${parents}" ${index})
				list(APPEND parent_names "${parent}")
			endforeach()
		else()
			set(parent_names "${parents}")
		endif()
		foreach(parent IN LISTS parent_names)
			resolve_configure_value("${parent}" "${setting}" value)
			if(NOT value STREQUAL "")
				set("${output}" "${value}" PARENT_SCOPE)
				return()
			endif()
		endforeach()
	endif()
	set("${output}" "" PARENT_SCOPE)
endfunction()

file(READ "${source_dir}/CMakePresets.json" root)
if(root MATCHES "CMAKE_COLOR_DIAGNOSTICS|CMAKE_INSTALL_MESSAGE|debug:Output|trace:Expanded|test-output:On_failure|CMakeUserPresets")
	message(FATAL_ERROR "共有プリセットに利用者の表示設定または個人設定への依存を含めることはできません")
endif()
string(JSON count LENGTH "${root}" configurePresets)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
	string(JSON preset GET "${root}" configurePresets ${index})
	string(JSON name GET "${preset}" name)
	set(allowed name hidden inherits condition vendor displayName description "$comment")
	if(name STREQUAL "base:project")
		set(allowed name hidden description binaryDir installDir cacheVariables environment "$comment")
	else()
		string(JSON cache_type ERROR_VARIABLE cache_error TYPE "${preset}" cacheVariables)
		if(cache_error STREQUAL "NOTFOUND")
			string(JSON cache_count LENGTH "${preset}" cacheVariables)
			if(NOT cache_count EQUAL 0)
				message(FATAL_ERROR "configurePresets/${name}：キャッシュ設定を軸プリセットに移してください")
			endif()
			list(APPEND allowed cacheVariables)
		endif()
	endif()
	check_members("${preset}" "${allowed}" "configurePresets/${name}")
	string(JSON hidden ERROR_VARIABLE hidden_error GET "${preset}" hidden)
	if(NOT hidden_error STREQUAL "NOTFOUND" OR NOT hidden)
		if(NOT name MATCHES "^(x86_64|aarch64|\\*)-([A-Za-z0-9_]+|\\*)-([a-z0-9_]+|\\*)-([a-z0-9_]+|\\*)-")
			message(FATAL_ERROR "${name}：tripleの4項目を指定してください。省略する項目には*を使います")
		endif()
		set(arch "${CMAKE_MATCH_1}")
		set(environment "${CMAKE_MATCH_4}")
		resolve_configure_value("${name}" binaryDir binary_dir)
		resolve_configure_value("${name}" installDir install_dir)
		if(binary_dir MATCHES "\\*|\\$\\{presetName\\}|\\$\\{configurePresetName\\}" OR
			install_dir MATCHES "\\*|\\$\\{presetName\\}|\\$\\{configurePresetName\\}")
			message(FATAL_ERROR "${name}：固定されたレイアウトを明示してください")
		endif()
		if(NOT arch STREQUAL "*")
			resolve_configure_value("${name}" MY_IMPORT_STD_TARGET_ARCH selected_arch)
			resolve_configure_value("${name}" MY_IMPORT_STD_CPU_BASELINE cpu)
			if(NOT selected_arch STREQUAL arch)
				message(FATAL_ERROR "${name}：標的アーキテクチャとプリセット名が一致しません")
			endif()
			if(arch STREQUAL "x86_64")
				set(expected_cpu x86-64-v3)
				set(cpu_component x86_64_v3)
			else()
				set(expected_cpu armv8.2-a)
				set(cpu_component "Armv8\\.2_A")
			endif()
			if(NOT cpu STREQUAL expected_cpu)
				message(FATAL_ERROR "${name}：CPU baselineとアーキテクチャが一致しません")
			endif()
			if(NOT name MATCHES "-${cpu_component}(-|$)")
				message(FATAL_ERROR "${name}：CPU baselineを示す名前の要素がありません")
			endif()
		endif()
		if(environment STREQUAL "gnu")
			resolve_configure_value("${name}" MY_IMPORT_STD_TARGET_ENVIRONMENT selected_environment)
			if(NOT selected_environment STREQUAL "gnu")
				message(FATAL_ERROR "${name}：GNU/glibc環境が指定されていません")
			endif()
		endif()
	endif()
endforeach()
file(GLOB infrastructure_files "${source_dir}/cmake/generic-build-infrastructure/*.cmake")
file(GLOB toolchain_files "${source_dir}/cmake/toolchains/*.cmake")
list(APPEND infrastructure_files ${toolchain_files})
foreach(infrastructure_file IN LISTS infrastructure_files)
	file(READ "${infrastructure_file}" implementation)
	if(implementation MATCHES "MY_IMPORT_STD_|my_import_std|PROJECT_SOURCE_DIR")
		message(FATAL_ERROR "${infrastructure_file}：汎用処理に案件名や案件内のパスを含めることはできません")
	endif()
endforeach()
if(DEFINED CHECK_BINARY_DIR)
	if(NOT IS_ABSOLUTE "${CHECK_BINARY_DIR}")
		message(FATAL_ERROR "CHECK_BINARY_DIRには絶対パスを指定してください")
	endif()
	set(fixture "${CHECK_BINARY_DIR}/shared-only")
	file(MAKE_DIRECTORY "${fixture}/cmake/presets")
	file(COPY_FILE "${source_dir}/CMakePresets.json" "${fixture}/CMakePresets.json")
	foreach(axis_file IN LISTS axis_files)
		cmake_path(GET axis_file FILENAME filename)
		file(COPY_FILE "${axis_file}" "${fixture}/cmake/presets/${filename}")
	endforeach()
	execute_process(
		COMMAND "${CMAKE_COMMAND}" --list-presets=all
		WORKING_DIRECTORY "${fixture}"
		COMMAND_ERROR_IS_FATAL ANY
	)

	set(relocated "${CHECK_BINARY_DIR}/relocated")
	file(MAKE_DIRECTORY "${relocated}/infrastructure/presets" "${relocated}/cmake/toolchains")
	file(COPY_FILE "${source_dir}/cmake/presets/CMakeGenericBuildInfrastructurePresets.json"
		"${relocated}/infrastructure/presets/CMakeGenericBuildInfrastructurePresets.json")
	file(COPY ${toolchain_files} DESTINATION "${relocated}/cmake/toolchains")
	if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
		set(host Windows)
	else()
		set(host Linux)
	endif()
	file(WRITE "${relocated}/CMakePresets.json" "{
		\"version\": 13,
		\"include\": [\"infrastructure/presets/CMakeGenericBuildInfrastructurePresets.json\"],
		\"configurePresets\": [{
			\"name\": \"relocated\",
			\"inherits\": [\"system:${host}(host:${host})\", \"generator:Ninja\"],
			\"binaryDir\": \"\${sourceDir}/build\"
		}]
	}\n")
	file(WRITE "${relocated}/CMakeLists.txt" "cmake_minimum_required(VERSION 4.5)
project(Relocated LANGUAGES NONE)
set(expected \"\${CMAKE_CURRENT_LIST_DIR}/cmake/toolchains/${host}.cmake\")
cmake_path(NORMAL_PATH CMAKE_TOOLCHAIN_FILE OUTPUT_VARIABLE actual)
if(NOT actual STREQUAL expected)
	message(FATAL_ERROR \"ソースルート内の標準配置のtoolchainが選択されていません：\${actual}\")
endif()
")
	execute_process(
		COMMAND "${CMAKE_COMMAND}" --preset relocated
		WORKING_DIRECTORY "${relocated}"
		COMMAND_ERROR_IS_FATAL ANY
	)
endif()
